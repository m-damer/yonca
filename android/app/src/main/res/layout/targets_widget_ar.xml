<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/targets_widget_background">

    <TextView
        android:fontFamily="@font/yonca_sans_ar"
        android:id="@+id/tw_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tw_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textAlignment="viewStart"
        android:textDirection="anyRtl" />

    <TextView
        android:fontFamily="@font/yonca_sans_ar"
        android:id="@+id/tw_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tw_ink2"
        android:textSize="13sp"
        android:textAlignment="viewStart"
        android:textDirection="anyRtl"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tw_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
        android:fontFamily="@font/yonca_sans_ar"
                android:id="@+id/tw_label1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
        android:fontFamily="@font/yonca_sans_ar"
                android:id="@+id/tw_value1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/tw_bar1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressTint="@color/tw_primary"
            android:progressBackgroundTint="@color/tw_track" />

        <TextView
        android:fontFamily="@font/yonca_sans_ar"
            android:id="@+id/tw_status1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tw_ink2"
            android:textSize="11sp"
            android:textAlignment="viewStart"
            android:textDirection="anyRtl"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
        android:fontFamily="@font/yonca_sans_ar"
                android:id="@+id/tw_label2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
        android:fontFamily="@font/yonca_sans_ar"
                android:id="@+id/tw_value2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/tw_bar2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressTint="@color/tw_primary"
            android:progressBackgroundTint="@color/tw_track" />

        <TextView
        android:fontFamily="@font/yonca_sans_ar"
            android:id="@+id/tw_status2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tw_ink2"
            android:textSize="11sp"
            android:textAlignment="viewStart"
            android:textDirection="anyRtl"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tw_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
        android:fontFamily="@font/yonca_sans_ar"
                android:id="@+id/tw_label3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
        android:fontFamily="@font/yonca_sans_ar"
                android:id="@+id/tw_value3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textDirection="ltr"
                android:maxLines="1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/tw_bar3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressTint="@color/tw_primary"
            android:progressBackgroundTint="@color/tw_track" />

        <TextView
        android:fontFamily="@font/yonca_sans_ar"
            android:id="@+id/tw_status3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/tw_ink2"
            android:textSize="11sp"
            android:textAlignment="viewStart"
            android:textDirection="anyRtl"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
