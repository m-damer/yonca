<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/targets_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aw_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tw_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aw_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/tw_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/tw_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/aw_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tw_ink2"
        android:textSize="13sp"
        android:textAlignment="viewStart"
        android:textDirection="anyRtl"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/aw_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/aw_ini1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/tw_circle_surface"
            android:textColor="@color/tw_ink2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/aw_info1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aw_name1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/aw_sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tw_ink2"
                android:textSize="11sp"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/aw_call1"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="7dp"
            android:background="@drawable/tw_circle_surface"
            android:src="@drawable/ic_w_phone"
            android:tint="@color/tw_primary"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aw_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/aw_ini2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/tw_circle_surface"
            android:textColor="@color/tw_ink2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/aw_info2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aw_name2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/aw_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tw_ink2"
                android:textSize="11sp"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/aw_call2"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="7dp"
            android:background="@drawable/tw_circle_surface"
            android:src="@drawable/ic_w_phone"
            android:tint="@color/tw_primary"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/aw_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/aw_ini3"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/tw_circle_surface"
            android:textColor="@color/tw_ink2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/aw_info3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aw_name3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tw_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/aw_sub3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tw_ink2"
                android:textSize="11sp"
                android:textAlignment="viewStart"
                android:textDirection="anyRtl"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/aw_call3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="7dp"
            android:background="@drawable/tw_circle_surface"
            android:src="@drawable/ic_w_phone"
            android:tint="@color/tw_primary"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
